{
  "name": "@found-in-space/voice-os",
  "version": "0.1.0-alpha.0",
  "description": "Headless voice interaction runtime with optional transport, browser and UI adapters",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Found-in-Space/voice-os.git"
  },
  "homepage": "https://github.com/Found-in-Space/voice-os#readme",
  "bugs": {
    "url": "https://github.com/Found-in-Space/voice-os/issues"
  },
  "keywords": [
    "voice",
    "realtime",
    "webrtc",
    "headless",
    "tools",
    "xr"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/transports/openai-realtime/index.d.ts",
      "import": "./dist/transports/openai-realtime/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./server/openai": {
      "types": "./dist/server/openai/index.d.ts",
      "import": "./dist/server/openai/index.js"
    },
    "./touch-os": {
      "types": "./dist/adapters/touch-os/index.d.ts",
      "import": "./dist/adapters/touch-os/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "example:build": "node scripts/build-examples.mjs",
    "example:serve": "npm run build && npm run example:build && node examples/server.mjs",
    "verify:release": "npm run typecheck && npm test && npm run test:package && npm run example:build",
    "release:metadata": "node scripts/release-metadata.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "peerDependencies": {
    "@found-in-space/touch-os": ">=0.3.0 <0.4.0"
  },
  "peerDependenciesMeta": {
    "@found-in-space/touch-os": {
      "optional": true
    }
  },
  "devDependencies": {
    "@found-in-space/skykit": "0.2.0",
    "@found-in-space/touch-os": "0.3.0",
    "@types/node": "22.18.6",
    "esbuild": "0.28.1",
    "three": "0.170.0",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
